# Ignore everything in this working tree by default, then re-include the
# website (site/), the released evaluation code, and the Pages workflow.
/*
!/.gitignore
!/README.md
!/CODE.md

# Project webpage (deployed to GitHub Pages from the site/ directory).
!/site/
!/site/**

# GitHub Actions workflow that publishes site/ to GitHub Pages.
!/.github/
!/.github/workflows/
!/.github/workflows/**

# ---------------------------------------------------------------------------
# MemoryVLN evaluation code package.
# ---------------------------------------------------------------------------
!/config/
!/config/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/setup.py
!/requirements.txt
!/__init__.py
!/LICENSE_APACHE-2.0.txt
!/LICENSE_VGGT.txt
!/THIRD_PARTY_NOTICES.md

# Never track large artifacts even if a rule above is relaxed.
**/__pycache__/
*.py[cod]
*.log
*.aux
